# Copy to .env and fill in. chmod 600 .env – this file holds every secret of the installation.

# ---- Domains (DNS A/AAAA records must point to this host before the first start) ----
SJODUR_DOMAIN=sjodur.example.com
SJODUR_AUTH_DOMAIN=auth.sjodur.example.com
SJODUR_API_DOMAIN=api.sjodur.example.com
ACME_EMAIL=ops@example.com

# ---- Images ----
FRONTEND_IMAGE=ghcr.io/OWNER/sjodur-frontend
BACKEND_IMAGE=ghcr.io/OWNER/sjodur-backend
SJODUR_VERSION=1.0.0
SJODUR_ENVIRONMENT=production
FRONTEND_REPLICAS=1
BACKEND_REPLICAS=1

# ---- Secrets: generate each with `openssl rand -base64 32` ----
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
SJODUR_OIDC_CLIENT_SECRET=
SJODUR_SESSION_SECRET=

# ---- Optional ----
SPRING_PROFILES_ACTIVE=prod            # add ",mail" for error digests, ",file" for log files
SJODUR_MAIL_HOST=
SJODUR_ALERT_MAIL=
LOG_LEVEL=info
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
