# Sjodur – single .gitignore for the whole repository.
# Patterns without a leading slash apply at every depth (root, backend/, frontend/, ...).

# ---- Gradle / Java (root build and backend) ----
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
.kotlin/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
hs_err_pid*
replay_pid*

# ---- Node / Vike (frontend) ----
node_modules/
dist/
.vite/
*.tsbuildinfo
test-results/
playwright-report/
blob-report/
THIRD-PARTY-NOTICES.md
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ---- Environment files: only the examples are committed ----
.env
.env.*
!.env.example

# ---- Logs (logback-spring.xml in the local profile, pino in dev) ----
logs/
*.log
*.log.gz

# ---- IDEs and editors ----
.idea/
*.iml
*.iws
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/
**/.vscode/*
!**/.vscode/extensions.json
.settings/
.classpath
.project
.factorypath
.springBeans
.sts4-cache/
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/
.fleet/
*.swp
*~

# ---- Operating systems ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- Misc ----
*.orig
*.rej
.cache/
# Bati's AI-agent notes – uncomment to keep them out of the repo:
# frontend/.agents/
# frontend/.claude/