# Copy to .env for local development. Containers get these as real environment variables.

# Identity provider (Keycloak from infra/docker-compose.yml, realm "sjodur")
SJODUR_OIDC_ISSUER=http://localhost:8081/realms/sjodur
SJODUR_OIDC_CLIENT_ID=sjodur-web
SJODUR_OIDC_CLIENT_SECRET=sjodur-web-secret-change-me

# This server as seen by the browser; redirect URIs are derived from it
SJODUR_PUBLIC_URL=http://localhost:3000

# Signs the short-lived login cookie. At least 32 random characters in production.
SJODUR_SESSION_SECRET=dev-only-session-secret-change-me-please

# Sessions: in memory when REDIS_URL is empty (dev), Redis in production
#REDIS_URL=redis://localhost:6379

# Spring backend for the /api proxy
SJODUR_API_URL=http://localhost:8080
